# DepVet local configuration. Copy to .env and fill in what you have.
# With no model settings at all, DepVet runs in a clearly marked mock
# model mode so the rest of the pipeline can be developed and demoed.

PORT=8730

# Model layer: any OpenAI-compatible endpoint. For the final entry this
# points at Nebius Token Factory. Switching providers is config only.
# Confirmed live against the Token Factory catalog on 2026-10-25.
# SPEND CAP: the account holds only a $1 trial credit and the saved card
# must never be charged. Keep total Token Factory spend far below $1.
MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_API_KEY=
# Fast model: extracts and classifies evidence from many sources.
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Strong model: writes the final reasoned verdict.
MODEL_STRONG=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional. Keyless works; a token only raises GitHub rate limits.
GITHUB_TOKEN=

# Live web evidence via Tavily: incident, advisory and maintenance
# news searches plus page extracts, merged into the brief as cited
# claims. With no key, briefs run on structured sources only and the
# web evidence section says so.
TAVILY_API_KEY=
